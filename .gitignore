# ==============================================================================
# AgroLink - Git Ignore Configuration
# Comprehensive rules for Flutter, Dart, Android, iOS, macOS, Web, IDEs, and Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
secrets.json

# Firebase configuration files (Contain live API keys & project credentials)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json
macos/Runner/GoogleService-Info.plist
macos/firebase_app_id_file.json

# Android Signing Keys & Credentials
*.keystore
*.jks
key.properties

# Apple / iOS Developer Certificates & Provisioning
*.mobileprovision
*.cer
*.p12
*.p8

# ------------------------------------------------------------------------------
# 2. Flutter & Dart Artifacts
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 3. Android Platform Specific
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/captures/
**/android/gradleBuild/
**/android/local.properties
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/app/build/

# ------------------------------------------------------------------------------
# 4. iOS & macOS Platform Specific
# ------------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/

# CocoaPods
**/ios/Pods/
**/macos/Pods/
**/ios/.symlinks/
**/macos/.symlinks/

# Xcode User Data & Temporary Files
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserdatad/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
**/DerivedData/

# ------------------------------------------------------------------------------
# 5. Linux & Windows Platform Specific
# ------------------------------------------------------------------------------
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# ------------------------------------------------------------------------------
# 6. Embedded Local Databases & Caches (Hive / SQLite)
# ------------------------------------------------------------------------------
*.hive
*.lock.hive
hive_testing/

# ------------------------------------------------------------------------------
# 7. IDE & Editor Artifacts
# ------------------------------------------------------------------------------
# JetBrains / IntelliJ IDEA / Android Studio
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code (Keep personal workspace settings untracked)
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json

# AI Assistant & Spec Temporary Folders
.kiro/
.specs/

# ------------------------------------------------------------------------------
# 8. Operating System Specific
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
Icon?

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# 9. Miscellaneous & Temporary Files
# ------------------------------------------------------------------------------
*.class
*.log
*.tmp
*.bak
*.swp
*.swo
.atom/
.build/
.buildlog/
.history/
.svn/
.swiftpm/
migrate_working_dir/
