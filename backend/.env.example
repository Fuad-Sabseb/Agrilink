# Server Configuration
PORT=5001
NODE_ENV=development
API_PREFIX=/api/v1
STORAGE_BASE_URL=http://localhost:5001

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/agrolink

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Ethio Telecom SMS Gateway Configuration
ETHIO_TELECOM_SMS_URL=https://api.ethiotelecom.et/sms/v1/send
ETHIO_TELECOM_API_KEY=your_ethio_telecom_api_key
ETHIO_TELECOM_SENDER_ID=AGROLINK
ETHIO_TELECOM_MOCK=true

# Telebirr Payment Gateway Configuration
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=your_shortcode
TELEBIRR_PUBLIC_KEY=your_telebirr_public_key
TELEBIRR_API_URL=https://app.ethiomobilemoney.et:2121/ammapi/payment/service-open/
TELEBIRR_NOTIFY_URL=http://your-domain.com/api/v1/payments/telebirr/callback
TELEBIRR_RETURN_URL=http://your-domain.com/api/v1/payments/telebirr/return
TELEBIRR_MOCK=true

# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=agrolink-ethiopia

# File Upload Settings
MAX_FILE_SIZE_MB=10
